##
# Build the MaxMind download URL for a given database edition by
# substituting the edition ID, current date, and archive type into the
# URL template.
# Globals:
#   DOWNLOAD_URL_TEMPLATE
#   CURRENT_DATE
#   DOWNLOAD_TYPE
# Arguments:
#   Edition ID (e.g. GeoLite2-City).
# Outputs:
#   Writes the built download URL to stdout.
##
build_download_url() {

  local edition_id="$1"
  local url="${DOWNLOAD_URL_TEMPLATE}"
  local date="${CURRENT_DATE}"
  local type="${DOWNLOAD_TYPE}"

  url="${url/EDITION_ID/${edition_id}}"
  url="${url/DATE/${date}}"
  url="${url/TYPE/${type}}"

  printf '%s' "${url}"

} # build_download_url()

##
# Build the archive file name for a given database edition.
