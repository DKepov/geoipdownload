#!/bin/bash

#
# geoipdownload
#
# geoipdownload — GeoIP and GeoLite Update Program.
#
# A lightweight bash alternative to the official geoipupdate client from MaxMind.
# Guaranteed to work on Linux with the required dependencies installed.
#
# Like the official geoipupdate tool, this script downloads only binary .mmdb
# database files packaged as tar.gz archives. CSV editions and other formats
# are not supported.
#
# Compatible with the GeoIP.conf configuration format used by the official
# geoipupdate tool up to version 4.0.0. Existing configuration files can be
# reused without any changes.
#
# Reads LicenseKey and EditionIDs from GeoIP.conf, downloads MaxMind archives
# in tar.gz format, and extracts *.mmdb files to the target directory.
#
# Expected GeoIP.conf format:
#   LicenseKey YOUR_LICENSE_KEY
#   EditionIDs GeoLite2-City GeoLite2-Country
#
#
# USAGE:
#   geoipdownload [-f CONFIG_FILE] [-d DATABASE_DIRECTORY] [-v] [-h] [-V]
#
# DEFAULTS:
#   -f  /etc/GeoIP.conf
#   -d  /usr/share/GeoIP
#
# EXAMPLE:
#   geoipdownload -f /etc/GeoIP.conf -d /usr/share/GeoIP
#   geoipdownload -f /etc/GeoIP.conf
#   geoipdownload
#
# For full parameters description run:
#   geoipdownload --help
#
#
# References:
#   https://dev.maxmind.com/geoip/updating-databases/
#   https://github.com/maxmind/geoipupdate
#

# Strict mode
#set -o errexit
set -o nounset
set -o pipefail

# Current version
readonly VERSION='0.110.0'

# Current program
readonly PROGRAM="geoipdownload/${VERSION}"

# Constants
readonly DOWNLOAD_URL_TEMPLATE='https://updates.maxmind.com/geoip/databases/EDITION_ID/download?date=DATE&suffix=TYPE'
readonly CURL_CONNECT_TIMEOUT=5
readonly CURL_MAX_TIME=60
readonly DOWNLOAD_TYPE='tar.gz'
readonly DATABASE_ARCHIVE_SUFFIX='.mmdb.tar.gz'
readonly DATABASE_FILE_SUFFIX='.mmdb'

# Lock file
readonly LOCK_FILE='.geoipdownload.lock'

# Defaults
readonly DEFAULT_CONFIG_FILE_ORIG='/etc/GeoIP.conf'
readonly DEFAULT_DATABASE_DIRECTORY_ORIG='/usr/share/GeoIP'
readonly DEFAULT_CONFIG_FILE_NEW='/usr/local/etc/GeoIP.conf'
readonly DEFAULT_DATABASE_DIRECTORY_NEW='/usr/local/share/GeoIP'

# Variables (will be filled in in the future)
CONFIG_FILE=''
DATABASE_DIRECTORY=''

# Verbose mode
VERBOSE=0

# Current date
CURRENT_DATE=$(date +'%Y%m%d')
readonly CURRENT_DATE

#
# Any message function template
#
message() {
  local date
  date=$(date +'%Y-%m-%dT%H:%M:%S%z')
  echo "[${date}]: $*"
} # mess()

#
# Error message
#
err() {
  local msg
  msg=$(message '[ERROR]' "$*")
  echo "${msg}" >&2
} # err()

#
# Info message
#
info() {
  local verbose=${VERBOSE}

  if [[ "${verbose}" -eq 1 ]]; then
    local msg
    msg=$(message '[INFO] ' "$*")
    echo "${msg}" >&2
  fi
} # info()

#
# Version of program
#
version() {
  local version=${VERSION}

  echo "geoipdownload ${version}"
} # version()

#
# Usage "--help" function
#
usage() {
  cat << 'EOF'
geoipdownload — GeoIP and GeoLite Update Program.

A lightweight bash alternative to the official geoipupdate client from MaxMind.
Guaranteed to work on Linux with the required dependencies installed.
Downloads binary .mmdb files only (tar.gz), same as the official geoipupdate tool.

Expected GeoIP.conf format:
  LicenseKey YOUR_LICENSE_KEY
  EditionIDs GeoLite2-City GeoLite2-Country


USAGE:
          geoipdownload [FLAGS] [-f CONFIG_FILE] [-d DATABASE_DIRECTORY]

FLAGS:

  -h, --help                    Show this help message.
  -v, --verbose                 Print informational and error messages.
  -V, --version                 Current version of program.

PARAMS:

  -f, --config-file             Path to GeoIP.conf.
                                Defaults to: /etc/GeoIP.conf
                                Defaults to: /usr/local/etc/GeoIP.conf
                                See GeoIP.conf and official documentation.

  -d, --database-directory      Path to Directory where .mmdb files will be written.
                                Defaults to: /usr/share/GeoIP
                                Defaults to: /usr/local/share/GeoIP
                                See GeoIP.conf and official documentation.
EOF
}

#
# Acquire lock
#
acquire_lock() {

  local lock_file="$1"

  # Open the lock file on file descriptor 9
  exec 9> "${lock_file}"

  # Try to acquire an exclusive non-blocking lock on fd 9
  if ! flock --nonblock 9; then
    err 'Another instance of geoipdownload is already running. Exiting.'
    exit 1
  fi

  # Write the current process PID to the lock file
  echo $$ > "${lock_file}"

  info 'Acquired lock on directory'

} # acquire_lock()

#
# Release lock
#
release_lock() {

  local lock_file="$1"

  # Do nothing if the lock file does not exist
  if [[ ! -f "${lock_file}" ]]; then
    return 0
  fi

  # Release the lock on file descriptor 9
  flock --unlock 9

  # Remove the lock file
  rm -f "${lock_file}"

  info 'Released lock on directory'

} # release_lock()

#
# Parsing of arguments
#
# Validation of the argument string via getopt
# Important: we are suppressing the verification of unknown parameters
#
parse_and_default_args() {

  local options
  local short_options
  local long_options

  # Validation of the argument string via getopt
  # --options sets short flags, --longoptions sets long flags.
  # "$@" passes the current script arguments.

  # Configuring the getopt utility
  short_options='f:d:vhV'
  long_options='config-file:,database-directory:,verbose,help,version'

  # Important: we are suppressing the verification of unknown parameters with --quiet
  options=$(getopt --quiet --options "${short_options}" --longoptions "${long_options}" --name "$0" -- "$@") 2> /dev/null || true

  # Overwriting the positional parameters of the script ($1, $2...) the cleared string from getopt
  eval set -- "${options}"

  while true; do
    case "${1:-}" in
      -f | --config-file)
        if [[ -z "${2:-}" || "$2" == -* || "$2" == --* ]]; then
          break
        fi
        CONFIG_FILE="$2"
        shift 2
        ;;
      -d | --database-directory)
        if [[ -z "${2:-}" || "$2" == -* || "$2" == --* ]]; then
          break
        fi
        DATABASE_DIRECTORY="$2"
        shift 2
        ;;
      -v | --verbose)
        VERBOSE=1
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      -V | --version)
        version
        exit 0
        ;;
      --)
        shift
        break
        ;;
      "")
        break
        ;;
      *)
        shift
        ;;
    esac
  done

  # Applying default values for missing required parameters
  if [[ -z "${CONFIG_FILE}" ]]; then
    info "The '--config-file (-f)' parameter was not specified. It will be used by default."
  fi

  if [[ -z "${DATABASE_DIRECTORY}" ]]; then
    info "The '--database-directory (-d)' parameter was not specified. It will be used by default."
  fi

} # parse_and_default_args()

#
# Check Config exists
#
# Checking Config on exists
# We display errors and information messages inside
#
take_checked_config_exists() {

  local conf_file="$1"

  info "Looking configuration file by path: ${conf_file}"

  if [[ ! -f "${conf_file}" ]]; then
    err "The configuration file '${conf_file}' not found!"
    return 1
  fi

  if [[ ! -r "${conf_file}" ]]; then
    err "The configuration file '${conf_file}' cannot be read!"
    return 1
  fi

  info "The configuration file '${conf_file}' found and ready for use."

  printf '%s' "${conf_file}"

} # take_checked_config_exists()

#
# Check Directory exists and writable
#
# Checking Directory on exists and writable
# We display errors and information messages inside
#
take_checked_directory_exists_and_writable() {

  local database_directory="$1"

  info "Looking database directory by path: ${database_directory}"

  if [[ ! -d "${database_directory}" ]]; then
    err "The database directory '${database_directory}' not found!"
    return 1
  fi

  if [[ ! -w "${database_directory}" ]]; then
    err "The database directory '${database_directory}' is not writable!"
    return 1
  fi

  # We are trying to create a hidden test file
  write_test_file="${database_directory}/.write_test"
  if touch "${write_test_file}" 2> /dev/null; then
    # Deleting it if it was created successfully
    rm -f "${write_test_file}"
  else
    err "The database directory '${database_directory}' is not writable!"
    return 1
  fi

  info "The database directory '${database_directory}' found and ready for use."

  printf '%s' "${database_directory}"

} # take_checked_directory_exists_and_writable()

#
# Read account id
#
# Reading account id to variable
# We display errors and information messages inside
#
read_account_id() {

  local conf_file="$1"
  local account_id

  account_id=$(grep -oP '^AccountID\s+\K\S+' "${conf_file}")

  # Checking the existence of the 'AccountID' in the configuration file
  if [[ -z "${account_id}" ]]; then
    err "The 'AccountID' parameter is empty or missing in '${conf_file}'!"
    return 1
  fi

  info "The 'AccountID' has been successfully read."

  printf '%s' "${account_id}"

} # read_account_id()

#
# Read license key
#
# Reading license key to variable
# We display errors and information messages inside
#
read_license_key() {

  local conf_file="$1"
  local license_key

  license_key=$(grep -oP '^LicenseKey\s+\K\S+' "${conf_file}")

  # Checking the existence of the 'LicenseKey' in the configuration file
  if [[ -z "${license_key}" ]]; then
    err "The 'LicenseKey' parameter is empty or missing in '${conf_file}'!"
    return 1
  fi

  info "The 'LicenseKey' has been successfully read."

  printf '%s' "${license_key}"

} # read_license_key()

#
# Read edition ids
#
# Reading edition ids to array variable
# We display errors and information messages inside
#
read_edition_ids() {

  local conf_file="$1"
  local edition_ids
  local edition_ids_line

  edition_ids_line=$(grep -Po "(?<=EditionIDs\s).*" "${conf_file}")

  # Checking the existence of the 'EditionIDs' in the configuration file
  if [[ -z "${edition_ids_line}" ]]; then
    err "The 'EditionIDs' parameter is empty or missing in '${conf_file}'!"
    return 1
  fi

  info "The 'EditionIDs' has been successfully read."

  #declare -a edition_ids=(
  #  "GeoLite2-ASN"
  #  "GeoLite2-City"
  #  "GeoLite2-Country"
  #)

  read -ra edition_ids <<< "${edition_ids_line}"

  edition_ids_line=$(printf "'%s' " "${edition_ids[@]}")
  edition_ids_line=${edition_ids_line% }
  info "The following databases were found for download: (${edition_ids_line})"

  printf '%s\n' "${edition_ids[@]}"

} # read_edition_ids()

#
# Build download url
#
# Building download url for current database
# We display errors and information messages inside
#
build_download_url() {

  local edition_id="$1"
  local url="${DOWNLOAD_URL_TEMPLATE}"
  local date="${CURRENT_DATE}"
  local type="${DOWNLOAD_TYPE}"

  url="${url/EDITION_ID/${edition_id}}"
  url="${url/DATE/${date}}"
  url="${url/TYPE/${type}}"

  printf '%s' "${url}"

} # build_download_url()

#
# Build archive name
#
# Building archive name for current database
# We display errors and information messages inside
#
build_archive_name() {

  local edition_id="$1"
  local edition_id_archive

  edition_id_archive="${edition_id}${DATABASE_ARCHIVE_SUFFIX}"

  printf '%s' "${edition_id_archive}"

} # build_archive_name()

#
# Build database name
#
# Building database name for current database
# We display errors and information messages inside
#
build_database_name() {

  local edition_id="$1"
  local edition_id_database

  edition_id_database="${edition_id}${DATABASE_FILE_SUFFIX}"

  printf '%s' "${edition_id_database}"

} # build_database_name()

#
# Download database archive
#
# Downloading archive database from download_url into archive_name
# We display errors and information messages inside
#
download_database_archive() {

  local database_directory="$1"
  local account_id="$2"
  local license_key="$3"
  local download_url="$4"
  local archive_name="$5"
  local curl_exit_code=0
  local curl_agent_program=${PROGRAM}
  local curl_connect_timeout=${CURL_CONNECT_TIMEOUT}
  local curl_max_time=${CURL_MAX_TIME}

  # Downloading Bases
  info 'Downloading the database archive from the MaxMind server ...'

  # CURL settings:
  # -sS : Hide the progress bar, but show a network error if it happens
  # -user : Basic Authorization <user:password>
  # --user-agent : Header for User-Agent
  # --location : Automatically navigates through redirects.
  # --fail : Return an error code if the server responds with 404, 500, etc.
  # --connect-timeout : Wait no more than X seconds to establish a connection
  # --max-time : General limit time to download one file (optional, for security reasons)
  curl -sS \
    --user "${account_id}:${license_key}" \
    --user-agent "${curl_agent_program}" \
    --location \
    --connect-timeout "${curl_connect_timeout}" \
    --max-time "${curl_max_time}" \
    --output "${database_directory}/${archive_name}" \
    "${download_url}" 2> /dev/null

  # Immediately save the curl return code to a variable
  # The $ variable? stores the status of the last executed command
  curl_exit_code=$?

  # Checking the variable with the Curl Code
  if [[ "${curl_exit_code}" -ne 0 ]]; then
    err "Curl ended with the code: ${curl_exit_code}"
    if [[ "${curl_exit_code}" -eq 28 ]]; then
      err 'The timeout has expired for Curl'
    elif [[ "${curl_exit_code}" -eq 22 ]]; then
      err 'The server returned an HTTP error (for example, 404 or 403 or 500)'
    elif [[ "${curl_exit_code}" -eq 23 ]]; then
      err 'Error writing the file to disk.'
    fi
    return 1
  fi

  printf '%s' "${database_directory}/${archive_name}"

} # download_database_archive()

#
# Check database archive
#
# Checking for archive database on valid type
# We display errors and information messages inside
#
check_database_archive() {

  local database_directory="$1"
  local archive_name="$2"
  local archive_error=""

  # Checking if the file has been downloaded, or is there an error from the api?
  # tar -tzf attempts to read the file as a real gzip+tar archive.
  # This is more reliable than checking file headers via the file command,
  # which may return different strings depending on OS and version.
  if ! tar -tzf "${database_directory}/${archive_name}" > /dev/null 2>&1; then
    err "MaxMind server error when downloading '${archive_name}':"
    # Output the error text (for example: "Invalid license key")
    archive_error=$(cat "${database_directory}/${archive_name}")
    err "${archive_error}"
    return 1
  fi

  info 'Downloading the database archive from the MaxMind server is successfully'

  printf '%s' "${database_directory}/${archive_name}"

} # check_database_archive()

# Delete database archive
#
# Deleting for archive database
# We display errors and information messages inside
#
delete_database_archive() {

  local database_directory="$1"
  local archive_name="$2"

  rm -f "${database_directory}/${archive_name}"

  printf '%s' "${database_directory}/${archive_name}"

} # delete_database_archive()

#
# Extract database from archive
#
# Extracting database from archive into single database file
# We display errors and information messages inside
#
extract_database_from_archive() {

  local database_directory="$1"
  local archive_name="$2"
  local database_name="$3"
  local files
  local check_exit_code=0
  local extract_exit_code=0

  # Downloading Bases
  info 'Extracting the Database file from the Database archive ...'

  files=$(tar -tf "${archive_name}" -C "${database_directory}" 2> /dev/null)

  # Immediately save the tar return code to a variable
  # The $ variable? stores the status of the last executed command
  check_exit_code=$?

  if [[ "${check_exit_code}" -ne 0 ]]; then
    err "Database archive does not contain '${database_name}' or the archive is corrupted".
    return 1
  fi

  if [[ ! "${files}" =~ ${database_name} ]]; then
    err "Database archive does not contain '${database_name}' or the archive is corrupted".
    return 1
  fi

  tar -zxf "${archive_name}" -C "${database_directory}" "${database_name}" 2> /dev/null

  # Immediately save the tar return code to a variable
  # The $ variable? stores the status of the last executed command
  extract_exit_code=$?

  # Checking the variable with the Curl Code
  if [[ "${extract_exit_code}" -ne 0 ]]; then
    err "Tar ended with the code: ${extract_exit_code}"
    if [[ "${extract_exit_code}" -eq 2 ]]; then
      err 'The file was not found in the archive or the archive is corrupted'
    fi
    return 1
  fi

  info 'Extracting the Database file from the Database archive is successfully'

  printf '%s' "${database_directory}/${database_name}"

} # extract_database_from_archive()

#
# Main function
#
main() {

  local version
  local config_file
  local database_directory
  local account_id
  local license_key
  local edition_ids
  local edition_id
  local download_url
  local archive_name
  local database_name
  local editions_raw
  local downloaded_database_archive
  local checked_database_archive
  local extracted_database_from_archive
  local deleted_database_archive
  local config_file_param=''        # The variable is empty here
  local database_directory_param='' # The variable is empty here
  local _config_file_candidate
  local config_file_orig="${DEFAULT_CONFIG_FILE_ORIG}"
  local config_file_new="${DEFAULT_CONFIG_FILE_NEW}"
  local _database_directory_candidate
  local database_directory_orig="${DEFAULT_DATABASE_DIRECTORY_ORIG}"
  local database_directory_new="${DEFAULT_DATABASE_DIRECTORY_NEW}"
  local lock_file="${LOCK_FILE}"

  # Show current version
  version=$(version)
  info "${version}"

  # Parsing of arguments
  parse_and_default_args "$@"

  # Important: repeated assignment!
  # Because the variables were unambiguously empty before parsing the variables
  # see: parse_and_default_args()
  config_file_param="${CONFIG_FILE}"
  database_directory_param="${DATABASE_DIRECTORY}"

  # Loop by Config file places
  # Important: This is Sorted list
  # Note: The first file that comes to hand is our working file.
  for _config_file_candidate in "${config_file_param}" "${config_file_orig}" "${config_file_new}"; do

    # Checking Config on exists
    config_file=$(take_checked_config_exists "${_config_file_candidate}")
    if [[ $? -eq 0 && -n "${config_file}" ]]; then
      break
    fi

  done
  # After the release, we should already have a value

  # Checking for exists Config or Exit
  # Errors we have in output
  if [[ $? -ne 0 && -z "${config_file}" ]]; then
    exit 1
  fi

  # Loop by Database Directories places
  # Important: This is Sorted list
  # Note: The first database directory that comes to hand is our working directory.
  for _database_directory_candidate in "${database_directory_param}" "${database_directory_orig}" "${database_directory_new}"; do

    # Checking Directory on exists and writable
    database_directory=$(take_checked_directory_exists_and_writable "${_database_directory_candidate}")
    if [[ $? -eq 0 && -n "${database_directory}" ]]; then
      break
    fi

  done
  # After the release, we should already have a value

  # Checking for exists Database Directory or Exit
  # Errors we have in output
  if [[ $? -ne 0 && -z "${database_directory}" ]]; then
    exit 1
  fi

  # Acquire lock to prevent multiple simultaneous instances
  acquire_lock "${database_directory}/${lock_file}"
  # It is triggered at any exit — normal, by mistake, or by signal.
  trap 'release_lock "${database_directory}/${lock_file}"' EXIT

  # Reading Account ID name for downloading
  account_id=$(read_account_id "${config_file}")
  if [[ $? -ne 0 && -z "${account_id}" ]]; then
    exit 1
  fi

  # Reading Licence name for downloading
  license_key=$(read_license_key "${config_file}")
  if [[ $? -ne 0 && -z "${license_key}" ]]; then
    exit 1
  fi

  # Reading Database names for downloading
  editions_raw=$(read_edition_ids "${config_file}")
  if [[ $? -ne 0 && -z "${editions_raw}" ]]; then
    exit 1
  fi
  mapfile -t edition_ids <<< "${editions_raw}"

  # In current point we are ready for downloading of databases

  info 'The databases downloading cycle is starting ...'

  # Walking through the array
  # And downloading database in current directory

  for edition_id in "${edition_ids[@]}"; do

    info "The current database is: '${edition_id}'"

    # Building download url for current database
    download_url="$(build_download_url "${edition_id}")"
    if [[ $? -ne 0 && -z "${download_url}" ]]; then
      exit 1
    fi

    # Building archive name for current database
    archive_name="$(build_archive_name "${edition_id}")"
    if [[ $? -ne 0 && -z "${archive_name}" ]]; then
      exit 1
    fi

    # Building database name for current database
    database_name="$(build_database_name "${edition_id}")"
    if [[ $? -ne 0 && -z "${database_name}" ]]; then
      exit 1
    fi

    # Downloading archive database from download_url into archive_name
    downloaded_database_archive=$(download_database_archive "${database_directory}" "${account_id}" "${license_key}" "${download_url}" "${archive_name}")
    if [[ $? -ne 0 && -z "${downloaded_database_archive}" ]]; then
      exit 1
    fi

    # Checking for archive database on valid type
    checked_database_archive=$(check_database_archive "${database_directory}" "${archive_name}")
    if [[ $? -ne 0 && -z "${checked_database_archive}" ]]; then
      exit 1
    fi

    # Extracting database from archive into single database file
    extracted_database_from_archive=$(extract_database_from_archive "${database_directory}" "${archive_name}" "${database_name}")
    if [[ $? -ne 0 && -z "${extracted_database_from_archive}" ]]; then
      exit 1
    fi

    # Deleting for archive database
    deleted_database_archive=$(delete_database_archive "${database_directory}" "${archive_name}")
    if [[ $? -ne 0 && -z "${deleted_database_archive}" ]]; then
      exit 1
    fi

    info "The '${edition_id}' database has been updated."

  done

  # Release lock to prevent multiple simultaneous instances
  release_lock "${database_directory}/${lock_file}"

  info 'All GeoIP databases have been successfully updated!'

} # main()

main "$@"
